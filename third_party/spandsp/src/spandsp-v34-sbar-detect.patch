+
+static void s_not_s_detector(v34_rx_state_t *s, const int16_t amp[], int len)
+{
+    int i;
+
+    if (!s->s_signal_seen  ||  s->s_not_s_seen)
+        return;
+    /*endif*/
+    for (i = 0;  i < len;  i++)
+    {
+        complexf_t z = dds_lookup_complexf(s->s_det_phase_short);
+        float x = amp[i];
+        s->s_det_short_re += x*z.re;
+        s->s_det_short_im -= x*z.im;
+        dds_advancef(&s->s_det_phase_short, s->s_det_rate_short);
+        if (++s->s_det_short_count >= 16)
+        {
+            float phase = atan2f(s->s_det_short_im, s->s_det_short_re);
+            float magnitude = hypotf(s->s_det_short_re, s->s_det_short_im)/16.0f;
+            if (!s->s_det_ref_valid)
+            {
+                s->s_det_ref_phase = phase;
+                s->s_det_ref_valid = magnitude > 300.0f;
+            }
+            else if (magnitude > 300.0f)
+            {
+                float coherence = cosf(phase - s->s_det_ref_phase);
+                if (coherence < -0.45f)
+                    s->s_det_nots_hits++;
+                else if (coherence > 0.45f)
+                {
+                    s->s_det_nots_hits = 0;
+                    s->s_det_ref_phase = phase;
+                }
+                /*endif*/
+                if (s->s_det_nots_hits >= 2)
+                {
+                    s->s_not_s_seen = true;
+                    span_log(s->logging, SPAN_LOG_FLOW,
+                             "Rx - S-to-!S transition detected from carrier phase reversal\n");
+                    return;
+                }
+                /*endif*/
+            }
+            /*endif*/
+            s->s_det_short_count = 0;
+            s->s_det_short_re = 0.0f;
+            s->s_det_short_im = 0.0f;
+        }
+        /*endif*/
+    }
+    /*endfor*/
 }
 /*- End of function --------------------------------------------------------*/
 
