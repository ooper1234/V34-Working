+/* Primary-channel data generator (our addition).
+
+   The mapping engine (v34_get_mapping_frame) consumes data bits and produces
+   one mapping frame: eight 2D symbols in Q9.7 format. This generator serves
+   those symbols one per baud through the primary-channel modulator. */
+static complex_sig_t get_data_baud(v34_state_t *s)
+{
+    int i;
+    complex_sig_t z;
+
+    if (s->tx.data_baud_pos >= 8)
+    {
+        v34_get_mapping_frame(&s->tx, s->tx.data_bits);
+        s->tx.data_baud_pos = 0;
+        /* Enable V34_SYM_TRACE to log the first four frames of each
+           superframe, for comparing against a waveform capture. */
+        if (getenv("V34_SYM_TRACE")  &&  s->tx.super_frame < 2  &&  s->tx.data_frame < 8)
+            span_log(&s->logging, SPAN_LOG_FLOW, "SYM %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d\n",
+                     s->tx.data_frame,
+                     s->tx.data_bits[0], s->tx.data_bits[1], s->tx.data_bits[2], s->tx.data_bits[3],
+                     s->tx.data_bits[4], s->tx.data_bits[5], s->tx.data_bits[6], s->tx.data_bits[7],
+                     s->tx.data_bits[8], s->tx.data_bits[9], s->tx.data_bits[10], s->tx.data_bits[11],
+                     s->tx.data_bits[12], s->tx.data_bits[13], s->tx.data_bits[14], s->tx.data_bits[15]);
+    }
+    /*endif*/
+    i = s->tx.data_baud_pos++;
+    /* Q9.7 to the modulator's signal units.  Training symbols use
+       TRAINING_AMP as one constellation unit; applying only the Q9.7
+       conversion made B1/data about 20 dB quieter than TRN, violating
+       10.1.3 and causing the far modem to lose carrier at B1. */
+    z.re = (float) s->tx.data_bits[2*i]*(0.7071068f*TRAINING_AMP)/128.0f;
+    z.im = (float) s->tx.data_bits[2*i + 1]*(0.7071068f*TRAINING_AMP)/128.0f;
+    return z;
+}
+/*- End of function --------------------------------------------------------*/
+
+static void data_baud_init(v34_state_t *s)
+{
+    span_log(&s->logging, SPAN_LOG_FLOW, "Tx - data_baud_init()\n");
+    s->tx.tone_duration = 0;
+    s->tx.stage = V34_TX_STAGE_DATA;
+    s->tx.current_modulator = V34_MODULATION_V34;
+    s->tx.current_getbaud = get_data_baud;
+    s->tx.data_baud_pos = 8;
+    /* No timing reset here. The control-channel modulator keeps its own baud
+       phase and filter buffer, so the primary channel's symbol grid and
+       pulse-shaping history are exactly as the training sequence left them,
+       and the data phase continues that grid. The receiver, which also keeps
+       its primary timing through the control exchanges, therefore finds the
+       data on the grid it trained on. */
+}
