+static complex_sig_t get_train_wait_baud(v34_state_t *s)
+{
+    /* V.34 11.3.1.2.4 to 11.3.1.2.6: after detecting the call modem's S-to-!S
+       transition the answer modem transmits silence while receiving PP, the
+       first 512T of TRN, and J.  J correlation is still TODO, so use a short
+       bounded acquisition interval covering PP (288T), 512T of TRN, and the
+       line/packet delay.  Keep it adjustable for hardware measurements. */
+    int wait_ms = 300;
+    const char *w = getenv("V34_ANSWER_TRAIN_WAIT_MS");
+    int wait_symbols;
+
+    if (w  &&  atoi(w) > 0)
+        wait_ms = atoi(w);
+    /*endif*/
+    wait_symbols = (int) (exact_baud_rate(s->tx.baud_rate)*wait_ms/1000.0);
+
+    if (++s->tx.tone_duration >= wait_symbols)
+        phase4_preamble_init(s);
+    /*endif*/
+    return zero;
+}
+/*- End of function --------------------------------------------------------*/
+
+static complex_sig_t get_phase4_s_baud(v34_state_t *s)
+{
+    float x;
+
+    /* V.34 11.4.1.2.1: the answer modem transmits S for 128T and !S for 16T,
+       followed by TRN. */
+    switch (s->tx.stage)
+    {
+    case V34_TX_STAGE_PHASE4_S:
+        if (++s->tx.tone_duration == 128)
+        {
+            s->tx.lastbit.re = -s->tx.lastbit.re;
+            s->tx.stage = V34_TX_STAGE_PHASE4_NOT_S;
+            s->tx.tone_duration = 0;
+        }
+        /*endif*/
+        break;
+    case V34_TX_STAGE_PHASE4_NOT_S:
+        if (++s->tx.tone_duration == 16)
+        {
+            s->tx.trn_after_j = true;
+            trn_baud_init(s);
+        }
+        /*endif*/
+        break;
+    }
+    /*endswitch*/
+    x = s->tx.lastbit.re;
+    s->tx.lastbit.re = s->tx.lastbit.im;
+    s->tx.lastbit.im = x;
+    return s->tx.lastbit;
+}
+/*- End of function --------------------------------------------------------*/
+
+static void phase4_preamble_init(v34_state_t *s)
+{
+    span_log(&s->logging, SPAN_LOG_FLOW, "Tx - phase 4 preamble (S/!S/TRN)\n");
+    s->tx.lastbit = complex_sig_set(TRAINING_SCALE(TRAINING_AMP), TRAINING_SCALE(0.0f));
+    s->tx.tone_duration = 0;
+    s->tx.current_modulator = V34_MODULATION_V34;
+    s->tx.stage = V34_TX_STAGE_PHASE4_S;
+    s->tx.current_getbaud = get_phase4_s_baud;
+}
