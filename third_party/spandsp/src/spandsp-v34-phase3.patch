+/* Phase-3 S signal detection (our addition over upstream spanDSP).
+
+   The S/!S alignment signal is the first phase-3 signal sent on the V.34
+   carrier. It is the baseband symbol sequence (1,0),(0,1),(1,0),(0,1)...
+   with periodic 180 degree reversals, i.e. coherent components at DC and at
+   half the baud rate. Two coherent correlators (at the far end's carrier and
+   at carrier + baud_rate/2) over short blocks detect it. A run of blocks
+   over the threshold raises V34_EVENT_S, which gates the phase-3 transmit
+   sequence on the other side. This is signal based: no timer or energy-only
+   heuristics are involved. */
+#define V34_S_DET_BLOCK     80      /* 10 ms blocks */
+#define V34_S_DET_HITS      3       /* consecutive qualifying blocks */
+
+static void s_signal_detector_init(v34_rx_state_t *s)
+{
+    float fc;
+
+    /* The S signal and the phase-3 training are transmitted by the far end on
+       the carrier it advertised for the working rate in its INFO1 message. */
+    {
+        const char *f = getenv("V34_FORCE_CARRIER");
+        if (f)
+            s->high_carrier = (f[0] == 'h'  ||  f[0] == 'H');
+        else
+            s->high_carrier = (s->calling_party)  ?  s->info1c.rate_data[s->baud_rate].use_high_carrier
+                                                 :  s->info1a.use_high_carrier;
+        /*endif*/
+    }
+    s->v34_carrier_phase_rate = dds_phase_ratef(carrier_frequency(s->baud_rate, s->high_carrier));
+    fc = carrier_frequency(s->baud_rate, s->high_carrier);
+    s->s_det_phase_fc = 0;
+    s->s_det_rate_fc = dds_phase_ratef(fc);
+    /* Second candidate carrier: the far end's phase-3 carrier has been seen
+       to differ from the one its INFO1 message suggests, so the detector
+       checks both and adopts the one that hits. */
+    s->s_det_fc2_high = !s->high_carrier;
+    s->s_det_phase_fc2 = 0;
+    s->s_det_rate_fc2 = dds_phase_ratef(carrier_frequency(s->baud_rate, s->s_det_fc2_high));
+    s->s_det_acc_a2_re = 0.0f;
+    s->s_det_acc_a2_im = 0.0f;
+    {
+        /* Candidate carriers: both carriers of every supported baud rate. The
+           far end's phase-3 symbol rate, and therefore its carrier, is not
+           known at S detection time (real-line capture shows a 2400 baud
+           training from a modem whose INFO1 exchanges list other rates). */
+        int b;
+        int hh;
+        s->s_det_multi_count = 0;
+        for (b = 0;  b < 6;  b++)
+        {
+            for (hh = 0;  hh < 2;  hh++)
+            {
+                int idx = s->s_det_multi_count;
+                s->s_det_multi_baud[idx] = b;
+                s->s_det_multi_high[idx] = hh;
+                s->s_det_phase_multi[idx] = 0;
+                s->s_det_rate_multi[idx] = dds_phase_ratef(carrier_frequency(b, hh));
+                s->s_det_acc_multi_re[idx] = 0.0f;
+                s->s_det_acc_multi_im[idx] = 0.0f;
+                s->s_det_multi_count++;
+            }
+            /*endfor*/
+        }
+        /*endfor*/
+    }
+    s->s_det_multi_carrier_high = false;
+    s->s_det_multi_baud_rate = 0;
+    /* The second correlator runs at this side's control-channel carrier. The
+       phase-1 A/B tones and the INFO messages are coherent there, while the
+       S signal is not, so this acts as a rejection filter. */
+    s->s_det_phase_nyq = 0;
+    s->s_det_rate_nyq = s->cc_carrier_phase_rate;
+    s->s_det_acc_a_re = 0.0f;
+    s->s_det_acc_a_im = 0.0f;
+    s->s_det_acc_b_re = 0.0f;
+    s->s_det_acc_b_im = 0.0f;
+    s->s_det_power = 0.0f;
+    s->s_det_count = 0;
+    s->s_det_hits = 0;
+}
+/*- End of function --------------------------------------------------------*/
+
+static void s_signal_detector(v34_rx_state_t *s, const int16_t amp[], int len)
+{
+    int i;
+    float x;
+    complexf_t z;
+
+    if (s->s_signal_seen
+        || (s->stage != V34_RX_STAGE_INFO1A  &&  s->stage != V34_RX_STAGE_INFO1C))
+        return;
+    /*endif*/
+    for (i = 0;  i < len;  i++)
+    {
+        x = (float) amp[i];
+        z = dds_lookup_complexf(s->s_det_phase_fc);
+        s->s_det_acc_a_re += x*z.re;
+        s->s_det_acc_a_im -= x*z.im;
+        dds_advancef(&s->s_det_phase_fc, s->s_det_rate_fc);
+        z = dds_lookup_complexf(s->s_det_phase_fc2);
+        s->s_det_acc_a2_re += x*z.re;
+        s->s_det_acc_a2_im -= x*z.im;
+        dds_advancef(&s->s_det_phase_fc2, s->s_det_rate_fc2);
+        {
+            int ci;
+            for (ci = 0;  ci < s->s_det_multi_count;  ci++)
+            {
+                z = dds_lookup_complexf(s->s_det_phase_multi[ci]);
+                s->s_det_acc_multi_re[ci] += x*z.re;
+                s->s_det_acc_multi_im[ci] -= x*z.im;
+                dds_advancef(&s->s_det_phase_multi[ci], s->s_det_rate_multi[ci]);
+            }
+            /*endfor*/
+        }
+        z = dds_lookup_complexf(s->s_det_phase_nyq);
+        s->s_det_acc_b_re += x*z.re;
+        s->s_det_acc_b_im -= x*z.im;
+        dds_advancef(&s->s_det_phase_nyq, s->s_det_rate_nyq);
+        s->s_det_power += x*x;
+        if (++s->s_det_count >= V34_S_DET_BLOCK)
+        {
+            float a;
+            float a2;
+            float b;
+            float rms;
+            float an;
+            float an2;
+            float bn;
+            float rn;
+            float best_ratio = 0.0f;
+
+            a = sqrtf(s->s_det_acc_a_re*s->s_det_acc_a_re + s->s_det_acc_a_im*s->s_det_acc_a_im);
+            a2 = sqrtf(s->s_det_acc_a2_re*s->s_det_acc_a2_re + s->s_det_acc_a2_im*s->s_det_acc_a2_im);
+            b = sqrtf(s->s_det_acc_b_re*s->s_det_acc_b_re + s->s_det_acc_b_im*s->s_det_acc_b_im);
+            rms = sqrtf(s->s_det_power);
+            /* Normalised statistics, measured on the real waveform: the
+               S signal is coherent on the V.34 carrier (an/rn about 0.3)
+               while the A/B tones (an/rn about 0.7, CC carrier) and the INFO
+               messages are coherent on the control-channel carrier instead.
+               Detect: coherent carrier energy present, control-channel tone
+               absent, sustained over consecutive blocks. */
+            an = a/V34_S_DET_BLOCK;
+            an2 = a2/V34_S_DET_BLOCK;
+            bn = b/V34_S_DET_BLOCK;
+            rn = rms/sqrtf(V34_S_DET_BLOCK);
+            {
+                /* Multi-carrier evaluation. Thresholds are from real-line
+                   measurements: the far end's phase-3 bursts peak at 0.38 to
+                   0.53 normalised coherence with a block RMS around 1200 to
+                   1700, while the line noise floor stays below 0.05 and the
+                   control-channel signal gives a high coherence at its own
+                   carrier only (rejected by the bn term when it is active). */
+                int ci;
+                int best_idx = -1;
+                for (ci = 0;  ci < s->s_det_multi_count;  ci++)
+                {
+                    float c;
+                    c = sqrtf(s->s_det_acc_multi_re[ci]*s->s_det_acc_multi_re[ci]
+                              + s->s_det_acc_multi_im[ci]*s->s_det_acc_multi_im[ci]);
+                    c /= V34_S_DET_BLOCK;
+                    if (rn > 0.0f  &&  c/rn > best_ratio)
+                    {
+                        best_ratio = c/rn;
+                        best_idx = ci;
+                    }
+                    /*endif*/
+                }
+                /*endfor*/
+                if (rn > 700.0f  &&  best_ratio > 0.25f  &&  bn < 0.25f*rn)
+                {
+                    s->s_det_hits++;
+                    if (best_idx >= 0)
+                    {
+                        s->s_det_multi_baud_rate = s->s_det_multi_baud[best_idx];
+                        s->s_det_multi_carrier_high = s->s_det_multi_high[best_idx];
+                    }
+                    /*endif*/
+                }
+                else if (rn > 3000.0f  &&  (an > 0.20f*rn  ||  an2 > 0.20f*rn)  &&  bn < 0.15f*rn)
+                {
+                    s->s_det_hits++;
+                    s->s_det_hit_high = (an2 > an)  ?  s->s_det_fc2_high  :  s->high_carrier;
+                }
+                else
+                {
+                    /* Packet and block boundaries can place a short window
+                       across the alternating S waveform's cancellation null.
+                       Decay confidence instead of discarding all prior signal
+                       evidence; acquisition still requires repeated coherent
+                       carrier blocks and rejects the control-channel tone. */
+                    if (s->s_det_hits > 0)
+                        s->s_det_hits--;
+                    /*endif*/
+                }
+                /*endif*/
+            }
+            span_log(s->logging, SPAN_LOG_FLOW, "Rx - S detector: an/rn=%.3f best=%.3f bn/rn=%.3f rn=%.0f hits=%d\n",
+                     an/rn, best_ratio, bn/rn, rn, s->s_det_hits);
+            if (s->s_det_hits >= V34_S_DET_HITS  &&  !s->s_signal_seen)
+            {
+                s->s_signal_seen = true;
+                s->received_event = V34_EVENT_S;
+                /* INFO1 selected the Phase 3 rate and carrier. The strongest
+                   multi-rate S correlator bin can be an alias, so use it to
+                   detect S without replacing the negotiated parameters. */
+                s->v34_carrier_phase_rate = dds_phase_ratef(carrier_frequency(s->baud_rate, s->high_carrier));
+                span_log(s->logging, SPAN_LOG_FLOW,
+                         "Rx - S signal detected (V34_EVENT_S), baud code %d, carrier %s\n",
+                         s->baud_rate, s->high_carrier  ?  "high"  :  "low");
+            }
+            /*endif*/
+            s->s_det_acc_a_re = 0.0f;
+            s->s_det_acc_a_im = 0.0f;
+            s->s_det_acc_a2_re = 0.0f;
+            s->s_det_acc_a2_im = 0.0f;
+            {
+                int ci;
+                for (ci = 0;  ci < s->s_det_multi_count;  ci++)
+                {
+                    s->s_det_acc_multi_re[ci] = 0.0f;
+                    s->s_det_acc_multi_im[ci] = 0.0f;
+                }
+                /*endfor*/
+            }
+            s->s_det_acc_b_re = 0.0f;
+            s->s_det_acc_b_im = 0.0f;
+            s->s_det_power = 0.0f;
+            s->s_det_count = 0;
+        }
+        /*endif*/
+    }
+    /*endfor*/
+}
